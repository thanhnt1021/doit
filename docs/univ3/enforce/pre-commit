#!/usr/bin/env python3
"""Git pre-commit hook — HARNESS-AGNOSTIC (chạy với Claude, Codex, hay người).

Đây là tầng cưỡng chế nền: hook của harness (Claude/Codex) khác nhau, nhưng git
pre-commit chạy cho MỌI commit → không bypass được bằng cách đổi agent.

Chặn (exit 1):
  1. Tiếng Việt thiếu dấu trong file .md staged (user-facing).
  2. docs/GOAL.md còn placeholder template (chưa điền thật).
Cảnh báo (không chặn):
  3. File .md mới >300 dòng trong thư mục univ3 (nhắc tách payload).
  4. Sửa file trong univ3 mà chưa chạm VERSION/MANIFEST (nhắc bump + gen).

Cài: install.py copy file này vào .git/hooks/pre-commit (chmod +x).
Bỏ qua 1 lần: `git commit --no-verify` (đừng lạm dụng).
Fail-safe: lỗi bất ngờ -> cho qua (exit 0), không chặn oan.
"""
import os
import re
import subprocess
import sys

BAD_PATTERNS = [
    (r"\bquay lai\b", "quay lại"), (r"\bbam nut\b", "bấm nút"),
    (r"\bhien tai\b", "hiện tại"), (r"\bhoat dong\b", "hoạt động"),
    (r"\bgioi thieu\b", "giới thiệu"), (r"\bbat dau\b", "bắt đầu"),
    (r"\bsu dung\b", "sử dụng"), (r"\bthong bao\b", "thông báo"),
    (r"\bvui long\b", "vui lòng"), (r"\bdang ky\b", "đăng ký"),
    (r"\bbao cao\b", "báo cáo"), (r"\btu dong\b", "tự động"),
    (r"\bdanh sach\b", "danh sách"), (r"\bnguoi dung\b", "người dùng"),
    (r"\bkhong co\b", "không có"), (r"\bket qua\b", "kết quả"),
    (r"\bthong tin\b", "thông tin"), (r"\bnoi dung\b", "nội dung"),
    (r"\btat ca\b", "tất cả"), (r"\bchuc nang\b", "chức năng"),
    (r"\btieng viet\b", "tiếng Việt"), (r"\bbat buoc\b", "bắt buộc"),
    (r"\bkhach hang\b", "khách hàng"), (r"\bthanh cong\b", "thành công"),
]
PLACEHOLDERS = [r"\[YYYY-MM-DD\]", r"\[Viết 1-2 câu", r"\[Tiêu chí \d",
                r"\[mô tả\]", r"\[Item chưa quyết định", r"\[Thứ dễ bị lạc vào"]


def sh(args):
    try:
        return subprocess.run(args, capture_output=True, text=True).stdout
    except Exception:
        return ""


def staged_files():
    out = sh(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"])
    return [f for f in out.splitlines() if f.strip()]


def staged_content(path):
    return sh(["git", "show", f":{path}"])


def main():
    files = staged_files()
    errors, warnings = [], []

    for f in files:
        low = f.lower()
        if any(s in low for s in ("univ3/", "universal_rules/", "universal-workflow/")):
            continue  # bộ rule chứa ví dụ pattern — bỏ qua diacritics
        if low.endswith(".md"):
            content = staged_content(f)
            hits = []
            for pat, ok in BAD_PATTERNS:
                m = re.search(pat, content, re.IGNORECASE)
                if m:
                    hits.append(f'"{m.group()}" -> "{ok}"')
            if hits:
                errors.append(f"[tiếng Việt thiếu dấu] {f}:\n    " + "\n    ".join(hits[:8]))

    # GOAL.md placeholder
    goal = next((g for g in ("docs/GOAL.md", "GOAL.md") if os.path.exists(g)), None)
    if goal:
        try:
            gtext = open(goal, encoding="utf-8").read()
            found = [p for p in PLACEHOLDERS if re.search(p, gtext)]
            if found:
                errors.append(f"[GOAL chưa điền] {goal} còn placeholder: {', '.join(found)}")
        except OSError:
            pass

    # Secret leak scan — chặn commit secret thật (mọi loại file) + file nhạy cảm
    SECRET_PATTERNS = [
        (r"sk-[A-Za-z0-9]{20,}", "API key (sk-…)"),
        (r"[0-9]{9,10}:[A-Za-z0-9_-]{35}", "Telegram bot token"),
        (r"postgres(?:ql)?://[^:@/\s]+:[^@/\s]{4,}@", "DB URL có mật khẩu"),
        (r"AIza[0-9A-Za-z_-]{35}", "Google API key"),
        (r"AKIA[0-9A-Z]{16}", "AWS access key"),
        (r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----", "private key"),
    ]
    SENSITIVE = ("secret.key", ".claude/settings.local.json")
    SAFE = ("removed", "placeholder", "your_", "user:password", "<remove", "xxxx", "example")
    for f in files:
        low = f.lower()
        if any(s in low for s in ("univ3/", "universal_rules/", "universal-workflow/")):
            continue  # bộ rule chứa pattern ví dụ
        if low.endswith(".example"):
            continue
        if any(f == s or f.endswith("/" + s) for s in SENSITIVE):
            errors.append(f"[secret] KHÔNG commit `{f}` — file nhạy cảm, thêm vào .gitignore.")
            continue
        content = staged_content(f)
        for pat, label in SECRET_PATTERNS:
            m = re.search(pat, content)
            if m and not any(s in m.group().lower() for s in SAFE):
                errors.append(f"[secret] {f}: nghi lộ {label} (`{m.group()[:12]}…`) — dùng .env, đừng commit giá trị thật.")
                break

    # Warn: md >300 dòng mới trong univ3
    for f in files:
        if "univ3/" in f.lower() and f.lower().endswith(".md"):
            n = len(staged_content(f).splitlines())
            if n > 300:
                warnings.append(f"{f} = {n} dòng (>300) — cân nhắc tách payload sang skills/references.")
    # Warn: sửa univ3 mà chưa chạm VERSION/MANIFEST
    univ3_changed = [f for f in files if "univ3/" in f.lower()]
    meta_touched = any(os.path.basename(f) in ("VERSION", "MANIFEST.txt") for f in files)
    if univ3_changed and not meta_touched:
        warnings.append("Sửa file univ3 nhưng chưa bump VERSION / gen MANIFEST — nhớ chạy trước khi push SSOT.")

    for w in warnings:
        print(f"⚠️  {w}", file=sys.stderr)
    if errors:
        print("\n".join(f"❌ {e}" for e in errors), file=sys.stderr)
        print("\nSửa các lỗi trên rồi commit lại (hoặc `git commit --no-verify` nếu thật sự cần bỏ qua).",
              file=sys.stderr)
        sys.exit(1)
    sys.exit(0)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)  # fail-safe: không chặn oan
